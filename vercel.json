{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "alias": [
    "jawhara-almalim-studio.vercel.app",
    "rukn-dareen-kitchen-studio.vercel.app",
    "ruaad-alabdae-kitchens.vercel.app",
    "alab3ad-modern-kitchens.vercel.app",
    "blum-com-kitchen-studio.vercel.app",
    "alnojoom-althalatha-kitchens.vercel.app",
    "kitchens-sandy-khamis.vercel.app",
    "aluminum-smart-kitchen-studio.vercel.app",
    "zawq-al-khayal-kitchens.vercel.app"
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/jawhara",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "jawhara-almalim-studio.vercel.app"
        }
      ]
    },
